# Token from @BotFather (required)
TELEGRAM_BOT_TOKEN=
# Comma separated Telegram user IDs that may use the bot. Empty = everyone.
ALLOWED_USER_IDS=
# How often all plates are checked (min 30s)
POLL_INTERVAL=3m
# Pause between two API requests while polling
REQUEST_GAP=1s
# Reminder before the 48h online payment window closes, 0 = off
REMIND_BEFORE=12h
# Max plates per user
MAX_PLATES=10
