# Token from @BotFather (required)
TELEGRAM_BOT_TOKEN=
# Comma separated Telegram user IDs of admins. Admins get access requests of
# unknown users and approve them with /users, /allow, /block.
ADMIN_USER_IDS=
# Comma separated Telegram user IDs that always have access (in addition to approved users).
# If both ADMIN_USER_IDS and ALLOWED_USER_IDS are empty, everyone may use the bot.
ALLOWED_USER_IDS=
# How often all plates are checked (min 30s)
POLL_INTERVAL=3m
# Pause between two API requests while polling
REQUEST_GAP=1s
# Reminder before the 48h online payment window closes, 0 = off
REMIND_BEFORE=12h
# Max plates per user
MAX_PLATES=10
